# ── Frontend (safe to expose; injected at build time by Vite) ────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_APP_URL=http://localhost:5173
# Web Push public key (from `npm run gen-vapid`)
VITE_VAPID_PUBLIC_KEY=

# ── Edge functions / server-only (set with `supabase secrets set`, NEVER here in prod) ─
# SUPABASE_URL and SUPABASE_ANON_KEY are provided to functions automatically.
# SUPABASE_SERVICE_ROLE_KEY is provided automatically.
# CRON_SECRET=long-random-string-shared-with-pg_cron
# APP_URL=https://deadlinemate.com
# RESEND_API_KEY=re_...
# EMAIL_FROM=DeadlineMate <reminders@deadlinemate.com>
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@deadlinemate.com
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
